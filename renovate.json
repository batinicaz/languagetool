{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>batinicaz/gha:renovate-preset"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG LT_VERSION=(?<currentValue>\\d+\\.\\d+)\\n"],
      "depNameTemplate": "languagetool-org/languagetool",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG MAVEN_VERSION=(?<currentValue>[\\d.]+)\\n"],
      "depNameTemplate": "apache/maven",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^maven-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\nARG \\w+_VERSION=(?<currentValue>\\S+)\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}maven{{/if}}"
    }
  ]
}
